pubspec.lock
**/android/.gradle/
**/android/local.properties
**/android/key.properties
*.jks

# `flutter test` doesn't build package:sqlite3's native-assets hook, so a
# local sqlite3 shared library is needed for packages/syncedu_local's tests
# to resolve sqlite3_initialize (see test/flutter_test_config.dart). Each
# machine supplies its own copy; it is not redistributed via git.
packages/syncedu_local/sqlite3.dll

# ── Content build output ─────────────────────────────────────────────────
# The chapter HTML under content/ is the tracked source; the PDFs are a
# deterministic build artefact (scripts/build_content_pdfs.ts) and binary.
content/pdf/

